# ==============================================================================
# AUTO-TRADE-AA: Production Environment (.env.prod)
# COPY to .env on VPS BEFORE running: docker compose -f docker-compose.prod.yml up -d --build
# ==============================================================================

# --- System & Security ---
APP_ENV=production
LOG_LEVEL=INFO
BACKEND_API_SECRET=CHANGE_THIS_TO_32_CHAR_RANDOM_STRING_MIN
LIVE_TRADING_ENABLED=false
CORS_ORIGINS=https://trade.your-domain.com

# --- Database (PostgreSQL 16) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=autotrade_db
POSTGRES_USER=autotrade_app
POSTGRES_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD
DATABASE_URL=postgresql+asyncpg://autotrade_app:CHANGE_THIS_TO_STRONG_PASSWORD@postgres:5432/autotrade_db

# --- Optional Redis Cache ---
REDIS_ENABLED=false
REDIS_HOST=redis
REDIS_PORT=6379

# --- AI Model Gateway (REQUIRED for live signals) ---
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=sk-or-YOUR_REAL_OPENROUTER_KEY_HERE
OPENROUTER_DEFAULT_MODEL=anthropic/claude-haiku-5.5
NINEROUTE_BASE_URL=
NINEROUTE_API_KEY=
NINEROUTE_DEFAULT_MODEL=google/gemini-flash-1.5

# --- Market Data: Solana ---
HELIUS_API_KEY=
SOLANA_COMMITMENT=confirmed

# --- Market Data: Binance Spot (Primary) ---
BINANCE_API_KEY=YOUR_BINANCE_API_KEY
BINANCE_API_SECRET=YOUR_BINANCE_API_SECRET
BINANCE_TESTNET=false

# --- Risk Parameters ---
INITIAL_PAPER_CAPITAL_USD=10000.00
MAX_RISK_PER_TRADE_PCT=0.005
DAILY_LOSS_LIMIT_PCT=0.02
MAX_DRAWDOWN_LIMIT_PCT=0.08
MAX_SPREAD_PCT=0.0008
DATA_FRESHNESS_MAX_AGE_SEC=30

# --- Auth Secrets (GENERATE ON VPS) ---
# JWT_SECRET_KEY: openssl rand -hex 32
# FIELD_ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
JWT_SECRET_KEY=CHANGE_THIS_64_HEX_CHARS
FIELD_ENCRYPTION_KEY=CHANGE_THIS_FERNET_KEY

# --- Rust Risk Gate (optional) ---
ENGINE_URL=
ENGINE_TIMEOUT_MS=10

# --- Telegram Bot (REQUIRED for /kill switch) ---
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_FROM_BOTFATHER
TELEGRAM_ALLOWED_USER_ID=YOUR_TELEGRAM_USER_ID
TELEGRAM_ALLOWED_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# --- Web Dashboard ---
NEXT_PUBLIC_API_URL=https://trade.your-domain.com
PORT=3000

# ==============================================================================
# GENERATION COMMANDS (run on VPS):
#   JWT_SECRET_KEY:  openssl rand -hex 32
#   FIELD_ENCRYPTION_KEY:  python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ==============================================================================